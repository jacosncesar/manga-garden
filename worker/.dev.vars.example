# Copy this file to .dev.vars for local testing with `wrangler dev`
# For production, set each secret with: npx wrangler secret put <NAME>

# Google OAuth Client ID (audience check for ID token verification)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# HMAC Salt for anonymous user quota hashing
JWT_SALT=replace-with-a-random-secret-before-use

# Provider Secrets (Set whichever you have enabled in src/config/providers.ts)
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
GEMINI_API_KEY=replace-with-your-gemini-api-key
GROQ_API_KEY=replace-with-your-groq-api-key
